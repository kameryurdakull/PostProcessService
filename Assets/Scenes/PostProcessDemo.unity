  _entries:
  - _preset: {fileID: 11400000, guid: 9a40f108355ee354e991e528fefb5fcf, type: 2}
    _button: {fileID: 628329037}
    _label: BLOOM
    _description: Bright surfaces bloom beyond their edges.
    _animateCamera: 0
  - _preset: {fileID: 11400000, guid: 6862de5549d87ee4fb12bf0d7089fa84, type: 2}
    _button: {fileID: 1648047276}
    _label: VIGNETTE
    _description: Soft edge falloff draws attention to the center.
    _animateCamera: 0
  - _preset: {fileID: 11400000, guid: 3b07d539e1dddb44189395294dcf3d37, type: 2}
    _button: {fileID: 1207439702}
    _label: CHROMATIC
    _description: Color channels separate toward the frame edges.
    _animateCamera: 0
  - _preset: {fileID: 11400000, guid: caea2bc819acd1a4b9c0e9eef647567e, type: 2}
    _button: {fileID: 1316664524}
    _label: LENS DISTORT
    _description: The image curves like a wide camera lens.
    _animateCamera: 0
  - _preset: {fileID: 11400000, guid: 8eb957772c4fc6c46bc48eb9db00c64b, type: 2}
    _button: {fileID: 178846880}
    _label: FILM GRAIN
    _description: Subtle analog noise adds texture to the image.
    _animateCamera: 0
  - _preset: {fileID: 11400000, guid: aa7f9314c38600940ae3b24cfbb75916, type: 2}
    _button: {fileID: 432448880}
    _label: COLOR GRADE
    _description: Exposure, contrast, hue and filter shape the mood.
    _animateCamera: 0
  - _preset: {fileID: 11400000, guid: d82158dda5885ec4e822c62b89d1c67a, type: 2}
    _button: {fileID: 1053599143}
    _label: WHITE BALANCE
    _description: Temperature and tint cool the environment.
    _animateCamera: 0
  - _preset: {fileID: 11400000, guid: f3b0283f0c18d2442934207dd18cb359, type: 2}
    _button: {fileID: 170343243}
    _label: DEPTH OF FIELD
    _description: Near and far objects blur around the focal plane.
    _animateCamera: 0
  - _preset: {fileID: 11400000, guid: d63b716151b04b24c8da4796c3cff34b, type: 2}
    _button: {fileID: 794854307}
    _label: MOTION BLUR
    _description: The camera moves to reveal temporal blur.
    _animateCamera: 1
  - _preset: {fileID: 11400000, guid: 0e5b80396f536e44da2b1e9e72a91667, type: 2}
    _button: {fileID: 188185264}
    _label: TONEMAPPING
    _description: ACES remaps highlights into a filmic range.
    _animateCamera: 0
  - _preset: {fileID: 11400000, guid: b39ae90b12244b340a6596d3bf518f61, type: 2}
    _button: {fileID: 495512579}
    _label: COLOR LOOKUP
    _description: A custom LUT shifts the entire color palette.
    _animateCamera: 0
  - _preset: {fileID: 11400000, guid: 532a2fd033cde9644bb05949b259e042, type: 2}
    _button: {fileID: 1091555942}
    _label: CINEMATIC MIX
    _description: Several overrides combine into one look.
    _animateCamera: 0
